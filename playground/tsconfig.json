{
  "extends": "../tsconfig.json",
  "include": ["."],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
  },
  "vueCompilerOptions": {
    "target": 2.7
  }
}
