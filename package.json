{
  "name": "bun-plugin-vue2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir=dist --sourcemap --target=bun",
    "build:playground": "cd playground && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/bun": "latest",
    "@types/hash-sum": "^1.0.2",
    "hash-sum": "^2.0.0",
    "slash": "^3.0.0",
    "source-map": "^0.6.1",
    "vue": "^2.7.16"
  },
  "workspaces": [
    "playground",
    "packages/*"
  ],
  "module": "src/index.ts",
  "peerDependencies": {
    "typescript": "^5"
  }
}
