{
  "name": "bun-plugin-vue2",
  "version": "0.1.16",
  "type": "module",
  "author": "Drswith",
  "license": "MIT",
  "homepage": "https://github.com/Drswith/bun-plugin-vue2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drswith/bun-plugin-vue2.git"
  },
  "bugs": {
    "url": "https://github.com/Drswith/bun-plugin-vue2/issues"
  },
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --hot ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir=dist --sourcemap --target=bun",
    "build:playground": "cd playground && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "bun test",
    "tag": "bumpp",
    "release": "bumpp && bun publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/bun": "latest",
    "@types/hash-sum": "^1.0.2",
    "bumpp": "^10.3.1",
    "hash-sum": "^2.0.0",
    "slash": "^3.0.0",
    "source-map": "^0.6.1",
    "vue": "^2.7.16"
  },
  "workspaces": [
    "playground",
    "packages/*"
  ],
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
