{
  "name": "bun-plugin-vue2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir=dist --sourcemap --target=bun",
    "dev:playground": "cd playground && bun run dev",
    "build:playground": "cd playground && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "slash": "^3.0.0",
    "vue": "^2.7.16",
    "hash-sum": "^2.0.0"
  },
  "workspaces": [
    "playground",
    "playground-react",
    "packages/*"
  ],
  "module": "src/index.ts",
  "peerDependencies": {
    "typescript": "^5"
  }
}
